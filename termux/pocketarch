#!/data/data/com.termux/files/usr/bin/bash
# PocketArch — envoltorio único de `proot-distro login` (corre en Termux).
# Lo usan el Makefile, el alias `arch` y el selector de arranque.
#
#   pocketarch [opciones de login] [-- comando…]   entra al contenedor
#   pocketarch --probe                             sonda de link2symlink
#   pocketarch --installed                         ¿existe el contenedor?
#
# Se entra siempre con --no-link2symlink: la emulación de enlaces duros de
# proot tumba la sesión con signal 11 aunque la sonda la dé por buena. Sin
# ella el kernel devuelve EPERM al crear un enlace duro y los que faltan en
# los paquetes los repara el hook de pacman (scripts/fix-hardlinks.sh).
# La sonda es solo diagnóstico: guarda on/off en $STATE y nada lo lee.
#
# Un comando tras -- corre con PATH limpio (sin Termux ni Android).
set -euo pipefail

ALIAS=arch-arm
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/pocketarch/link2symlink"

die() {
	echo "ERROR: $*" >&2
	exit 1
}

installed() {
	# Sin -q: grep saldría antes y pipefail daría falso negativo por SIGPIPE.
	proot-distro list -q 2>/dev/null | grep -x "$ALIAS" >/dev/null
}

probe() {
	installed || die "el contenedor $ALIAS no existe (make container)"
	# Ruta fija dentro del contenedor: si la sesión de la sonda cae, la limpia
	# una segunda sesión con --no-link2symlink.
	PROBE_DIR="/var/tmp/.pocketarch-probe.$$"
	local rc=0
	trap 'proot-distro login --no-link2symlink "$ALIAS" -- rm -rf "$PROBE_DIR" || true' EXIT
	echo "==> Sonda de link2symlink (un ln en $ALIAS, sin --no-link2symlink)"
	# shellcheck disable=SC2016 # $1 se expande dentro del contenedor
	proot-distro login "$ALIAS" -- /bin/sh -c \
		'mkdir -p "$1" && : >"$1/a" && ln "$1/a" "$1/b"' sh "$PROBE_DIR" || rc=$?
	mkdir -p "$(dirname "$STATE")"
	if [ "$rc" -eq 0 ]; then
		echo on >"$STATE"
		echo "==> link2symlink responde (solo diagnóstico; se entra igual con --no-link2symlink)"
	else
		echo off >"$STATE"
		echo "==> link2symlink falla (salida $rc)"
	fi
}

case "${1:-}" in
--probe)
	probe
	exit
	;;
--installed)
	installed
	exit
	;;
-h | --help)
	sed -n '2,15s/^# \{0,1\}//p' "$0"
	exit
	;;
esac

CLEAN_PATH=/usr/local/sbin:/usr/local/bin:/usr/bin

opts=()
while [ $# -gt 0 ] && [ "$1" != -- ]; do
	opts+=("$1")
	shift
done

if [ $# -gt 1 ]; then
	shift
	exec proot-distro login --no-link2symlink "${opts[@]}" "$ALIAS" -- \
		/usr/bin/env PATH="$CLEAN_PATH" "$@"
fi
exec proot-distro login --no-link2symlink "${opts[@]}" "$ALIAS"
